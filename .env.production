# Same-origin relative paths only. The browser bundle must never contain the backend's own
# hostname (currently plain HTTP on MonsterASP) — Vercel proxies these paths server-side to the
# backend via the rewrites in vercel.json. This makes the build portable across the production
# Vercel domain, the staging Vercel domain, and any preview deployment without editing this file.
VITE_API_URL=/api
VITE_SIGNALR_URL=/hubs
