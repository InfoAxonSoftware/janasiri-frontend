# Template only — placeholders. Copy to .env.local (gitignored) and fill in for local overrides.
# Vite exposes VITE_-prefixed variables to the browser bundle at build time, so none of these
# are secrets by design — never put real credentials in a VITE_ variable.
#
# These localhost values are for local development only, where the browser talks directly to a
# locally-running backend. Production/staging Vercel deployments must NOT set these to an
# absolute backend URL — see .env.production, which uses same-origin relative paths ("/api",
# "/hubs") proxied server-side by vercel.json instead.

VITE_API_URL=http://localhost:5101/api
VITE_SIGNALR_URL=http://localhost:5101/hubs
